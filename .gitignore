# Build output
/target

# Local scratch workspace: audit reports, investigation notes, repro SQL.
# Tracked here rather than left to per-clone local excludes so every
# contributor gets the same behaviour without configuring anything.
# See temp/README.md for what belongs here.
/temp/

# Structural-tooling caches
/.ast-bro/

# Agent and editor configuration that is intentionally not part of the project
/AGENTS.md
/.aider*
/.clinerules
/.cline*
/.vscode/
/.idea/
# Unanchored so a nested credential file cannot be committed by accident.
.env
*.env

# Generated database caches, statistics and scratch databases
/.safe-migrate.cache
/.safe-migrate-stats.json
/live_test/
/test_migrations/
*.db
*.sqlite
*.sqlite3

# Local planning documents
/ROADMAP.md

# Artefacts left behind by crash and lock investigation
/heap.c.*
/pg_*.h.*
/log.txt
*.log

# Editor and OS noise
*.swp
*.swo
*~
.DS_Store
